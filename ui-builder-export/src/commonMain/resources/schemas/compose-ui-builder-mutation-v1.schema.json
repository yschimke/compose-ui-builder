{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.compose-preview.dev/ui-builder/mutation/v1",
  "title": "Compose UI Builder mutation",
  "description": "One DesignMutationV1 serialized with Kotlin's type discriminator.",
  "oneOf": [
    { "type": "object", "required": ["type", "node", "location"], "properties": { "type": { "const": "insertNode" } }, "additionalProperties": true },
    { "type": "object", "required": ["type", "nodeId", "location"], "properties": { "type": { "const": "moveNode" } }, "additionalProperties": true },
    { "type": "object", "required": ["type", "nodeId"], "properties": { "type": { "const": "deleteNode" } }, "additionalProperties": true },
    { "type": "object", "required": ["type", "nodeId"], "properties": { "type": { "const": "restoreNode" } }, "additionalProperties": true },
    { "type": "object", "required": ["type", "nodeId", "property", "value"], "properties": { "type": { "const": "setProperty" } }, "additionalProperties": true },
    { "type": "object", "required": ["type", "nodeId", "property"], "properties": { "type": { "const": "removeNodeProperty" } }, "additionalProperties": true },
    { "type": "object", "required": ["type", "name", "declaration"], "properties": { "type": { "const": "setStateVariable" } }, "additionalProperties": true },
    { "type": "object", "required": ["type", "name"], "properties": { "type": { "const": "removeStateVariable" } }, "additionalProperties": true },
    { "type": "object", "required": ["type", "componentKey", "declaration"], "properties": { "type": { "const": "declareComponent" } }, "additionalProperties": true },
    { "type": "object", "required": ["type", "componentKey"], "properties": { "type": { "const": "removeComponent" } }, "additionalProperties": true },
    { "type": "object", "required": ["type", "nodeId", "arguments"], "properties": { "type": { "const": "setComponentArguments" } }, "additionalProperties": true },
    { "type": "object", "required": ["type", "nodeId", "event", "actions"], "properties": { "type": { "const": "setEventBinding" } }, "additionalProperties": true },
    { "type": "object", "required": ["type", "nodeId", "modifiers"], "properties": { "type": { "const": "setModifiers" } }, "additionalProperties": true },
    { "type": "object", "required": ["type", "changes"], "properties": { "type": { "const": "updateEnvironment" } }, "additionalProperties": true },
    { "type": "object", "required": ["type", "sourceCatalogPin", "targetCatalogPin", "sourceDocumentHash", "targetDocumentHash", "previewDigest"], "properties": { "type": { "const": "upgradeCatalog" } }, "additionalProperties": true }
  ]
}
