<idea-plugin>
  <id>ee.schimke.composeai.ui-builder-poc</id>
  <name>Compose UI Builder POC</name>
  <vendor>Yuri Schimke</vendor>

  <description><![CDATA[
    Embeds the native Compose UI Builder in IntelliJ editor and preview views.
  ]]></description>

  <depends>com.intellij.modules.platform</depends>
  <depends>com.intellij.modules.json</depends>
  <!--
    addComposeTab is compiled from the bundled Jewel bridge, but a bundledModule Gradle dependency
    only supplies the compile classpath. Declaring the runtime module here makes the bridge (and its
    ToolWindowScope) a parent of this plugin's classloader in an installed IDE.
  -->
  <dependencies>
    <module name="intellij.platform.jewel.ideLafBridge" />
  </dependencies>

  <extensions defaultExtensionNs="com.intellij">
    <fileType
        name="Compose UI Builder Design"
        implementationClass="ee.schimke.composeai.uibuilder.intellij.UiBuilderDesignFileType"
        fieldName="INSTANCE"
        language="JSON"
        extensions="uid" />
    <json.customStructureViewFactory
        implementation="ee.schimke.composeai.uibuilder.intellij.UiBuilderStructureViewFactory" />
    <projectService
        serviceImplementation="ee.schimke.composeai.uibuilder.intellij.UiBuilderProjectService" />
    <fileEditorProvider
        implementation="ee.schimke.composeai.uibuilder.intellij.UiBuilderFileEditorProvider" />
    <fileEditorProvider
        implementation="ee.schimke.composeai.uibuilder.intellij.UiBuilderProjectFileEditorProvider" />
    <toolWindow
        id="Compose UI Builder"
        secondary="true"
        anchor="right"
        factoryClass="ee.schimke.composeai.uibuilder.intellij.UiBuilderToolWindowFactory" />
  </extensions>
  <actions>
    <group id="ComposeUiBuilder.Tools" text="Compose UI Builder" popup="true">
      <add-to-group group-id="ToolsMenu" anchor="last" />
      <action id="ComposeUiBuilder.OpenProjectDesign"
          class="ee.schimke.composeai.uibuilder.intellij.OpenProjectDesignAction"
          text="Open Checked-In Design…"
          description="Open a .uid or DesignDocumentV1 JSON design in the visual editor" />
      <action id="ComposeUiBuilder.BrowseServerDesigns"
          class="ee.schimke.composeai.uibuilder.intellij.OpenRemoteDesignAction"
          text="Browse Server Designs…"
          description="Connect to a Compose preview server and open one of its designs live" />
      <action id="ComposeUiBuilder.CopyAgentPrompt"
          class="ee.schimke.composeai.uibuilder.intellij.CopyAgentPromptAction"
          text="Copy Active Design for an Agent"
          description="Copy instructions that point a coding agent at the active design" />
      <separator />
      <action id="ComposeUiBuilder.OpenM3Editor"
          class="ee.schimke.composeai.uibuilder.intellij.OpenM3EditorAction"
          text="Open Material 3 Scratch Editor" />
      <action id="ComposeUiBuilder.OpenWearM3Editor"
          class="ee.schimke.composeai.uibuilder.intellij.OpenWearM3EditorAction"
          text="Open Wear M3 Scratch Editor" />
      <action id="ComposeUiBuilder.OpenWearWidgetEditor"
          class="ee.schimke.composeai.uibuilder.intellij.OpenWearWidgetEditorAction"
          text="Open Wear Widgets Scratch Editor" />
    </group>
  </actions>
  <extensions defaultExtensionNs="JavaScript">
    <JsonSchema.ProviderFactory
        implementation="ee.schimke.composeai.uibuilder.intellij.UiBuilderDesignSchemaProviderFactory" />
  </extensions>
</idea-plugin>
